# Ejemplo para desarrollo local: cp .env.example .env && ajusta lo necesario.
# run-local.sh aborta sin .env. CERO secretos reales aquí: solo placeholders.
# Los servicios aplican sus propios defaults si una var queda vacía.

# --- Base de datos (compose) ---
DOCKER_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres?sslmode=disable

# --- Auth compartido (HS256 local entre auth/infacadem/notes/social) ---
JWT_SECRET=dev-jwt-secret-change-me
JWT=dev-jwt-change-me

# --- Front (build args; relativo = mismo origen vía nginx) ---
API_BASE_URL=/api-auth
NOTES_BASE_URL=/api-notes
SOCIAL_BASE_URL=/api-social
ACADEMIC_BASE_URL=/api-academic

# --- SMTP (auth, placeholders) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=ejemplo@gmail.com
SMTP_PASSWORD=

# --- Google OAuth / Drive (vacíos = flujos Google deshabilitados) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8081/auth/google/callback

# --- Comunicación interna entre servicios ---
INTERNAL_API_KEY=dev-internal-key-change-me
SOCIAL_SERVICE_URL=http://social:8083
# Notes -> Social por gRPC (vacío = HTTP interno). Social escucha en SOCIAL_GRPC_PORT.
SOCIAL_GRPC_ADDR=social:9083
SOCIAL_GRPC_PORT=9083
AUTH_BASE_URL=http://auth:8080

# --- Proveedores externos (mock por defecto en local) ---
SUPABASE_URL=
DISCOVERY_URL=
CALENDAR_MODE=mock
STREAM_API_KEY=
STREAM_API_SECRET=dev-stream-secret-change-me
STREAM_MODE=mock
