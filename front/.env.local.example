# Local - por defecto usa relativo /api-* via nginx (front/nginx.conf), no necesita dominio
# Para test local puro, deja estos vacíos o sin file; el front usará /api-auth por defecto.
API_BASE_URL=/api-auth
NOTES_BASE_URL=/api-notes
SOCIAL_BASE_URL=/api-social
# Alternativa absoluta local directa (sin nginx):
# API_BASE_URL=http://localhost:8085
# NOTES_BASE_URL=http://localhost:8082
# SOCIAL_BASE_URL=http://localhost:8083
