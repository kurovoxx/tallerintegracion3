# Recovery email. Load these in the root .env or the auth server environment.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=sigmaacademy.noreply@gmail.com
# Google app password, never the account password. Keep the real value private.
SMTP_PASSWORD=
# Optional SMTP settings (defaults shown). SMTP_TLS_MODE: starttls (587) or tls (465).
# SMTP_FROM=sigmaacademy.noreply@gmail.com
# SMTP_FROM_NAME=Sigma Academy
# SMTP_TLS_MODE=starttls

# Email confirmation (same SMTP account). Optional link base: the email adds ?token=...
# Must be https (http only for localhost). Empty = the email only includes the code.
# EMAIL_VERIFICATION_URL=https://ti3-brojas.dev.censei.cl/verificar-correo
# Token lifetime, Go duration between 15m and 168h. Default 24h.
# EMAIL_VERIFICATION_TTL=24h
